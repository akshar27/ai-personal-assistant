# Copy to backend/.env and fill in.

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Signs the OAuth session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# openai | openai_first (OpenAI then local Ollama) | ollama
LLM_PROVIDER=openai
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Retrieval over email history
HISTORY_INGEST_MAX_MESSAGES=200
HISTORY_INGEST_QUERY=newer_than:180d
# Escalate borderline prompt-injection checks to the LLM (default off)
INJECTION_LLM_CHECK=false

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-personal-assistant

# Google OAuth — put the client file at backend/client_secret.json,
# or paste its JSON into GOOGLE_CLIENT_SECRET_JSON
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
# GOOGLE_CLIENT_SECRET_JSON=
